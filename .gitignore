# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
mishka_cms_core_resources-*.tar

# Temporary files, for example, from tests.
/tmp/

# The schema this extension tests against is derived, never written by hand: `mix ash.codegen` builds
# it from the resources, and it covers the accounts and runtime tables the blog borrows as well as the
# blog's own. That makes it a local build artifact of whoever is running the tests, not source — and
# committing it would fork it from the CMS's own migrations, which are the real ones in production.
#
# Regenerate with:  MIX_ENV=test mix ash.codegen <name>   (never edit these files)
/priv/repo/migrations/
/priv/resource_snapshots/

# CLDR data for languages other than English, downloaded by `MishkaCmsCore.Localized` in tests.
/priv/localize/

# MishkaInstaller keeps its plugin registry in Mnesia, on disk. It survives between runs, so a stale
# row can name a module that no longer exists and every hook for that event then refuses to run
# ("This event has plugins that are not loaded"). Local state, never source.
/.mnesia/

# Mnesia writes a crash dump into the CWD, next to `erl_crash.dump` and for the same reasons. One
# is 800 KB of binary, and a test run of this extension left one here.
MnesiaCore.*
