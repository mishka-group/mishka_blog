<div>
  <div>
    <div
      data-role="col-head"
      class="mb-[22px] flex flex-wrap items-start justify-between gap-6 max-[560px]:flex-col!"
    >
      <div>
        <h1 class="m-0 font-['Newsreader'] text-[30px] font-medium leading-[1.05] tracking-[-0.01em] text-[#17161a]">
          {gettext("Tags")}
        </h1>
        <div class="mt-[7px] text-[13.5px] font-medium text-[#7c7a75]">
          {gettext("Organize posts with tags and labels.")}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 max-[560px]:w-full!">
        <.link
          id="back-to-blog-btn"
          navigate={path(@socket, "/admin/dashboard/blog")}
          class="inline-flex h-[42px] items-center gap-[7px] rounded-xl border border-[#ecebe6] bg-white px-[15px] text-[12.5px] font-semibold text-[#5c5a54] transition-colors hover:bg-[#f7f6f3] max-[560px]:flex-1! max-[560px]:justify-center!"
        >
          <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" /> {gettext(
            "Back to Dashboard"
          )}
        </.link>

        <button
          type="button"
          id="add-tag-btn"
          phx-click={show_modal("blog-tag-form-modal")}
          class="inline-flex h-[42px] items-center gap-2 rounded-xl bg-[linear-gradient(140deg,#6d69e6,#4f4bcc)] px-[17px] text-[12.5px] font-bold text-white shadow-[0_5px_14px_rgba(79,75,204,0.28)] transition-opacity hover:opacity-95 max-[560px]:flex-1! max-[560px]:justify-center!"
        >
          <.icon name="hero-plus" class="size-4" /> {gettext("Add Tag")}
        </button>
      </div>
    </div>

    <%!-- Tag Form Modal (MishkaGervaz) --%>
    <.modal id="blog-tag-form-modal">
      <.live_component
        module={MishkaGervaz.Form.Web.Live}
        id={MishkaGervaz.Resource.Info.Form.component_id(MishkaBlog.Tag)}
        resource={MishkaBlog.Tag}
        current_user={@current_user}
      />
    </.modal>

    <%!-- Tags Table/ChipGrid Component (MishkaGervaz) --%>
    <.live_component
      module={MishkaGervaz.Table.Web.Live}
      id="tags-table"
      resource={MishkaBlog.Tag}
      current_user={@current_user}
      url_state={@url_state}
    />

    <.modal
      id="tag-versions-modal"
      width_class="max-w-[840px]"
      padding_class="p-0"
      on_cancel={JS.push("close_versions")}
    >
      <CardChrome.modal_head
        icon="hero-clock"
        title={gettext("Version history")}
        subtitle={@versions_tag_name || gettext("Loading…")}
      />

      <VersionHistory.panel
        id="tag-versions"
        versions={@versions}
        loading={@versions_loading}
        page={@versions_page}
        per_page={@versions_per_page}
        total={@versions_total}
        preview_id={@preview_version_id}
        master_ids={@version_masters}
        empty_hint={gettext("Edits to this tag will be recorded here.")}
      />
    </.modal>
  </div>
</div>
