<%!--
SPDX-FileCopyrightText: 2026 Mishka Group contributors <https://github.com/mishka-group/mishka_blog/graphs/contributors>

SPDX-License-Identifier: Apache-2.0
--%>

<div>
  <.link
    navigate={path(@socket, "/admin/dashboard/blog")}
    class="mb-[18px] inline-flex items-center gap-[7px] text-[12.5px] font-semibold text-[#8a877f] transition-colors hover:text-[#1b1a18]"
  >
    <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" /> {gettext(
      "Back to Blog Dashboard"
    )}
  </.link>

  <.header>
    {gettext("Analytics")}
    <:subtitle>
      {gettext(
        "How your posts are being read: one view is a reader opening a post, counted when the page is shown in a browser."
      )}
    </:subtitle>
    <:actions>
      <div class="inline-flex items-center gap-1 rounded-[12px] border border-[#ecebe6] bg-white p-1 shadow-[0_1px_2px_rgba(30,28,24,0.04)] max-[560px]:w-full!">
        <.link
          :for={range <- Analytics.ranges()}
          id={"analytics-range-#{range}"}
          patch={page_path(@socket, %{@period | days: range}, @sort)}
          aria-pressed={to_string(range == @period.days)}
          class={[
            "inline-flex h-8 items-center justify-center rounded-[9px] px-3.5 text-[12px] font-semibold transition-colors max-[560px]:flex-1!",
            (range == @period.days && "bg-[#f2f1fc] text-[#4f4bcc]") ||
              "text-[#6d6a63] hover:bg-[#f7f6f3]"
          ]}
        >
          {gettext("%{days} days", days: range)}
        </.link>
      </div>
    </:actions>
  </.header>

  <%!-- The filter bar: a pick or a clear patches the URL, so the page reads again and a reload keeps
        it. Each filter is gervaz's search select, its options read a page at a time as it opens. --%>
  <div
    id="analytics-filters"
    class="mb-5 grid grid-cols-[repeat(4,minmax(0,1fr))_auto] items-end gap-3 rounded-[16px] border border-[#ecebe6] bg-white p-3 shadow-[0_1px_2px_rgba(30,28,24,0.04)] max-[980px]:grid-cols-2! max-[560px]:grid-cols-1!"
  >
    <%!-- gervaz's list is as wide as its input; here it grows to its longest label, up to the
          screen's width, so a label with its language and site stays on one line. --%>
    <div
      :for={{key, label} <- filter_fields()}
      class="flex min-w-0 flex-col gap-1 [&_[role=listbox]]:whitespace-nowrap [&_.z-50]:w-max [&_.z-50]:min-w-full [&_.z-50]:max-w-[min(92vw,30rem)]"
    >
      <div class="flex items-center justify-between gap-2">
        <span
          id={"analytics-filter-#{key}-label"}
          class="text-[11px] font-semibold text-[#8a877f]"
        >
          {label}
        </span>
        <button
          :if={@period.filters[key]}
          type="button"
          id={"analytics-clear-#{key}"}
          phx-click="clear_filter"
          phx-value-filter={key}
          class="text-[11px] font-semibold text-[#4f4bcc] hover:underline"
        >
          {gettext("Clear")}
        </button>
      </div>
      {search_select(picker_assigns(key, @pickers[key], @period.filters[key]))}
    </div>
    <form id="analytics-compare-form" phx-change="compare">
      <label class="flex h-9 cursor-pointer items-center gap-2 whitespace-nowrap px-1 text-[12px] font-semibold text-[#6d6a63]">
        <input type="hidden" name="compare" value="false" />
        <input
          id="analytics-compare"
          type="checkbox"
          name="compare"
          value="true"
          checked={@period.compare}
          class="size-4 rounded accent-[#5b57d6]"
        />
        {gettext("Compare with previous period")}
      </label>
    </form>
  </div>

  <%!-- KPI tiles, in the overview page's shape: two per row on a phone rather than three. A note
        wraps rather than being cut, since a phone's tile is narrower than its sentence. --%>
  <div
    data-role="analytics-kpis"
    class="mb-5 grid grid-cols-5 gap-4 max-[1180px]:grid-cols-3! max-[980px]:grid-cols-2!"
  >
    <div
      :for={
        {label, icon, tone, value, note, note_tone} <-
          kpi_cards(@panels.overview, @period.days, @blog_areas)
      }
      class="rounded-2xl border border-[#ecebe6] bg-white px-5 py-[18px] shadow-[0_1px_2px_rgba(30,28,24,0.04)]"
    >
      <div class="flex items-center gap-3 max-[560px]:flex-col! max-[560px]:items-start! max-[560px]:gap-2!">
        <span class={["grid size-10 flex-none place-items-center rounded-[11px]", tone]}>
          <.icon name={icon} class="size-[19px]" />
        </span>
        <div class="min-w-0 flex-1">
          <div class="truncate text-[11.5px] font-semibold text-[#8a877f]">{label}</div>
          <div
            :if={@panels.overview}
            class="mt-0.5 font-['Space_Grotesk'] text-[24px] font-semibold leading-[1.1] tracking-[-0.02em] text-[#17161a]"
          >
            {value}
          </div>
          <div
            :if={!@panels.overview}
            class="mt-[7px] h-[19px] w-[58%] animate-pulse rounded bg-[#eeedea]"
          >
          </div>
        </div>
      </div>
      <div
        :if={@panels.overview}
        class={["mt-[11px] text-[11px] font-semibold leading-snug", note_tone]}
      >
        {note}
      </div>
      <div
        :if={!@panels.overview}
        class="mt-[13px] h-2.5 w-[44%] animate-pulse rounded bg-[#f2f1ee]"
      >
      </div>
    </div>
  </div>

  <.tabbed id="analytics-chart" class="mb-4" title={gettext("Views Over Time")}>
    <:tab
      key="total"
      label={gettext("Total")}
      note={gettext("One point per day, over the last %{days} days", days: @period.days)}
      loading={is_nil(@panels.overview)}
    >
      <.empty
        :if={@panels.overview && @panels.overview.views_window == 0}
        text={gettext("No views recorded in the last %{days} days.", days: @period.days)}
      />

      <%!-- The viewBox is stretched to the card, so every stroke carries `non-scaling-stroke` — without
            it the line thins out as the card widens. --%>
      <div :if={@panels.overview && @panels.overview.views_window > 0}>
        <svg
          viewBox={view_box()}
          preserveAspectRatio="none"
          role="img"
          aria-label={chart_label(@panels.overview)}
          class="h-[180px] w-full"
        >
          <line
            :for={y <- gridlines()}
            x1="0"
            y1={y}
            x2={chart_width()}
            y2={y}
            stroke="#f0efea"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          <path
            d={
              area_path(
                @panels.overview.series,
                chart_peak(
                  @panels.overview.series,
                  @panels.overview.previous_series,
                  @period.compare
                )
              )
            }
            fill="#eef1fc"
          />
          <path
            :if={@period.compare}
            data-role="previous-line"
            d={
              line_path(
                @panels.overview.previous_series,
                chart_peak(
                  @panels.overview.series,
                  @panels.overview.previous_series,
                  @period.compare
                )
              )
            }
            fill="none"
            stroke="#a8a5a0"
            stroke-width="1.5"
            stroke-dasharray="5 4"
            vector-effect="non-scaling-stroke"
          />
          <path
            d={
              line_path(
                @panels.overview.series,
                chart_peak(
                  @panels.overview.series,
                  @panels.overview.previous_series,
                  @period.compare
                )
              )
            }
            fill="none"
            stroke="#5b57d6"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
        </svg>

        <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 text-[11px] font-medium text-[#a8a5a0]">
          <span>{day_label(@period.from)}</span>
          <span :if={@period.compare} class="inline-flex items-center gap-1.5">
            <span class="inline-block h-0 w-4 border-t-2 border-dashed border-[#a8a5a0]"></span>
            {gettext("Previous %{days} days: %{views}",
              days: @period.days,
              views: Localized.compact(@panels.overview.views_previous)
            )}
          </span>
          <span :if={!@period.compare}>
            {counted(:views_in_period, @panels.overview.views_window)}
          </span>
          <span>{day_label(@period.to)}</span>
        </div>
      </div>
    </:tab>
    <:tab
      key="categories"
      label={gettext("By category")}
      note={gettext("The five categories read most, and every other one together")}
      loading={is_nil(@panels.categories)}
    >
      <.empty
        :if={@panels.categories && @panels.categories.top == []}
        text={gettext("No category was read in this period.")}
      />
      <div :if={@panels.categories && @panels.categories.top != []}>
        <svg
          viewBox={view_box()}
          preserveAspectRatio="none"
          role="img"
          aria-label={gettext("Daily views stacked by category")}
          class="h-[180px] w-full"
        >
          <path
            :for={
              {_key, colour, d} <-
                stack_paths(@panels.categories.series, stack_keys(@panels.categories))
            }
            d={d}
            fill={colour}
            fill-opacity="0.85"
          />
        </svg>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-[11.5px] font-semibold text-[#6d6a63]">
          <li
            :for={{key, index} <- Enum.with_index(stack_keys(@panels.categories))}
            class="inline-flex items-center gap-1.5"
          >
            <span class="size-2.5 rounded-sm" style={"background: #{layer_colour(index)}"}></span>
            {layer_name(@panels.categories, key)}
          </li>
        </ul>
      </div>
    </:tab>
    <:tab
      key="publishing"
      label={gettext("Publishing")}
      note={gettext("Posts published each week, under the week's views")}
      loading={is_nil(@panels.overview)}
    >
      <div :if={@panels.overview}>
        <div class="relative h-[140px]">
          <div class="absolute inset-0 flex items-end gap-1.5">
            <div
              :for={week <- @panels.overview.weeks}
              class="flex h-full flex-1 flex-col justify-end"
              title={
                counted(:posts, week.posts) <> ", " <> counted(:views, week.views)
              }
            >
              <div
                class="rounded-t bg-[#dcdbf5]"
                style={"height: #{bar_height(week.posts, peak_of(@panels.overview.weeks, :posts))}%"}
              >
              </div>
            </div>
          </div>
          <svg
            viewBox={view_box()}
            preserveAspectRatio="none"
            role="img"
            aria-label={gettext("Weekly views over posts published")}
            class="absolute inset-0 h-full w-full"
          >
            <path
              d={weeks_line(@panels.overview.weeks)}
              fill="none"
              stroke="#1f9d6b"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="mt-2.5 flex flex-wrap justify-between gap-2 text-[11px] font-medium text-[#a8a5a0]">
          <span class="inline-flex items-center gap-1.5">
            <span class="size-2.5 rounded-sm bg-[#dcdbf5]"></span>{gettext("Posts published")}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block h-0.5 w-3 bg-[#1f9d6b]"></span>{gettext("Views")}
          </span>
        </div>
      </div>
    </:tab>
  </.tabbed>

  <.tabbed id="analytics-top" class="mb-4" icon="hero-trophy" title={gettext("Top")}>
    <:tab key="bloggers" label={gettext("Bloggers")} loading={is_nil(@panels.bloggers)}>
      <.empty :if={@panels.bloggers == []} text={gettext("No blogger was read in this period.")} />
      <ol :if={@panels.bloggers not in [nil, []]} class="flex flex-col gap-2.5">
        <li
          :for={blogger <- @panels.bloggers}
          class="rounded-[12px] border border-[#f0efea] bg-[#fdfdfc] px-3.5 py-2.5"
        >
          <div class="truncate text-[12.5px] font-bold text-[#1b1a18]">{name_of(blogger)}</div>
          <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-[11px] font-semibold text-[#8a877f]">
            <span>{counted(:views, blogger.views)}</span>
            <span>{counted(:posts_published, blogger.posts)}</span>
            <span :if={Home.holds?(@blog_areas, [:comment])}>
              {counted(:comments, blogger.comments || 0)}
            </span>
          </div>
        </li>
      </ol>
    </:tab>
    <:tab key="categories" label={gettext("Categories")} loading={is_nil(@panels.categories)}>
      <.bar_list
        :if={@panels.categories}
        rows={@panels.categories.top}
        empty={gettext("No category was read in this period.")}
      />
    </:tab>
    <:tab key="tags" label={gettext("Tags")} loading={is_nil(@panels.tags)}>
      <.bar_list
        :if={@panels.tags}
        rows={@panels.tags}
        empty={gettext("No tag was read in this period.")}
      />
    </:tab>
    <:tab key="teams" label={gettext("Teams")} loading={is_nil(@panels.teams)}>
      <.bar_list
        :if={@panels.teams}
        rows={@panels.teams}
        empty={gettext("No team was read in this period.")}
      />
    </:tab>
    <:tab
      :if={Home.holds?(@blog_areas, [:comment])}
      key="commenters"
      label={gettext("Commenters")}
      loading={is_nil(@panels.commenters)}
    >
      <.empty
        :if={@panels.commenters == []}
        icon="hero-user"
        text={gettext("No comment in this period.")}
      />
      <ol :if={@panels.commenters not in [nil, []]} class="flex flex-col gap-2">
        <li
          :for={row <- @panels.commenters}
          class="flex items-center justify-between gap-3 text-[12.5px]"
        >
          <span class="min-w-0 truncate font-semibold text-[#1b1a18]">{commenter(row.comment)}</span>
          <span class="flex-none font-semibold text-[#6d6a63]">{Localized.number(row.count)}</span>
        </li>
      </ol>
    </:tab>
  </.tabbed>

  <div class="mb-4 grid grid-cols-2 gap-4 max-[760px]:grid-cols-1!">
    <.panel
      id="analytics-post-age"
      icon="hero-clock"
      title={gettext("Post Age")}
      note={gettext("Views of new posts against older ones")}
      loading={is_nil(@panels.post_age)}
    >
      <div :if={@panels.post_age}>
        <.empty
          :if={post_age_total(@panels.post_age) == 0}
          text={gettext("No views recorded in the last %{days} days.", days: @period.days)}
        />
        <div :if={post_age_total(@panels.post_age) > 0}>
          <div class="flex h-3 overflow-hidden rounded-full bg-[#f2f1ee]">
            <div
              class="bg-[#5b57d6]"
              style={"width: #{round(@panels.post_age.fresh * 100 / post_age_total(@panels.post_age))}%"}
            >
            </div>
            <div
              class="bg-[#c3c0b8]"
              style={"width: #{round(@panels.post_age.older * 100 / post_age_total(@panels.post_age))}%"}
            >
            </div>
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-3">
            <div>
              <dt class="text-[11.5px] font-semibold text-[#8a877f]">
                {gettext("Published in the last %{days} days", days: @panels.post_age.fresh_days)}
              </dt>
              <dd class="mt-1 font-['Space_Grotesk'] text-[20px] font-bold text-[#5b57d6]">
                {Localized.compact(@panels.post_age.fresh)}
              </dd>
            </div>
            <div>
              <dt class="text-[11.5px] font-semibold text-[#8a877f]">{gettext("Older")}</dt>
              <dd class="mt-1 font-['Space_Grotesk'] text-[20px] font-bold text-[#6d6a63]">
                {Localized.compact(@panels.post_age.older)}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </.panel>

    <.panel
      id="analytics-weekdays"
      icon="hero-calendar"
      title={gettext("Day of Week")}
      note={gettext("Views by weekday over the period")}
      loading={is_nil(@panels.overview)}
    >
      <.empty
        :if={@panels.overview && @panels.overview.views_window == 0}
        text={gettext("No views recorded in the last %{days} days.", days: @period.days)}
      />
      <div :if={@panels.overview && @panels.overview.views_window > 0}>
        <div class="flex h-[140px] items-end gap-2">
          <div
            :for={day <- @panels.overview.weekdays}
            class="flex h-full flex-1 flex-col items-center justify-end gap-1.5"
          >
            <span class="text-[10.5px] font-semibold text-[#8a877f]">{Localized.compact(day.count)}</span>
            <div
              class="w-full rounded-t bg-[#5b57d6]"
              style={"height: #{bar_height(day.count, peak_of(@panels.overview.weekdays, :count))}%"}
            >
            </div>
          </div>
        </div>
        <div class="mt-2 flex gap-2 text-center text-[11px] font-semibold text-[#a8a5a0]">
          <span :for={day <- @panels.overview.weekdays} class="flex-1">{weekday_label(day.day)}</span>
        </div>
      </div>
    </.panel>
  </div>

  <div
    :if={Home.holds?(@blog_areas, [:comment])}
    class="mb-4 grid grid-cols-[2fr_1fr] gap-4 max-[980px]:grid-cols-1!"
  >
    <.panel
      id="analytics-comments"
      icon="hero-chat-bubble-left-right"
      title={gettext("Comments Over Time")}
      note={gettext("Comments written each day")}
      loading={is_nil(@panels.overview)}
    >
      <div :if={@panels.overview && @panels.overview.comments}>
        <.empty
          :if={@panels.overview.comments.window == 0}
          icon="hero-chat-bubble-left"
          text={gettext("No comment in this period.")}
        />
        <svg
          :if={@panels.overview.comments.window > 0}
          viewBox={view_box()}
          preserveAspectRatio="none"
          role="img"
          aria-label={counted(:comments_in_period, @panels.overview.comments.window)}
          class="h-[150px] w-full"
        >
          <path
            :if={@period.compare}
            d={
              line_path(
                @panels.overview.comments.previous_series,
                chart_peak(
                  @panels.overview.comments.series,
                  @panels.overview.comments.previous_series,
                  @period.compare
                )
              )
            }
            fill="none"
            stroke="#a8a5a0"
            stroke-width="1.5"
            stroke-dasharray="5 4"
            vector-effect="non-scaling-stroke"
          />
          <path
            d={
              line_path(
                @panels.overview.comments.series,
                chart_peak(
                  @panels.overview.comments.series,
                  @panels.overview.comments.previous_series,
                  @period.compare
                )
              )
            }
            fill="none"
            stroke="#3a6cb5"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
          />
        </svg>
        <div
          :if={@panels.overview.comments.window > 0}
          class="mt-2 text-[11px] font-medium text-[#a8a5a0]"
        >
          {counted(:comments_in_period, @panels.overview.comments.window)}
          <span :if={@period.compare}>
            · {gettext("%{count} in the previous %{days} days",
              count: Localized.number(@panels.overview.comments.previous),
              days: @period.days
            )}
          </span>
        </div>
      </div>
    </.panel>

    <.panel
      id="analytics-comment-status"
      icon="hero-inbox-stack"
      title={gettext("Comments")}
      note={gettext("Written in this period, by status")}
      loading={is_nil(@panels.comment_status)}
    >
      <div :if={@panels.comment_status} class="grid grid-cols-2 gap-2.5">
        <.link
          :for={{status, count} <- comment_tiles(@panels.comment_status)}
          id={"analytics-comments-#{status}"}
          navigate={comments_path(@socket, status, @period)}
          class="rounded-[12px] border border-[#f0efea] bg-[#fdfdfc] px-3.5 py-3 transition-colors hover:border-[#dcdbf5]"
        >
          <div class="text-[11.5px] font-semibold text-[#8a877f]">{status_word(status)}</div>
          <div class="mt-1 font-['Space_Grotesk'] text-[20px] font-bold text-[#17161a]">
            {Localized.number(count)}
          </div>
        </.link>
      </div>
    </.panel>
  </div>

  <.panel
    id="analytics-bottom"
    class="mb-4"
    icon="hero-trophy"
    title={gettext("Top Performing Posts")}
    note={gettext("Most-read posts of the last %{days} days", days: @period.days)}
    loading={is_nil(@panels.posts)}
  >
    <.empty
      :if={@panels.posts && @panels.posts.top == []}
      icon="hero-document-text"
      text={gettext("No post was opened in this period.")}
    />
    <div :if={@panels.posts && @panels.posts.top != []} class="-mx-1 overflow-x-auto">
      <table class="w-full min-w-[560px] text-[12.5px]">
        <thead>
          <tr class="text-[11px] font-semibold text-[#8a877f]">
            <th class="px-1 py-2 text-start">{gettext("Post")}</th>
            <th :for={{key, label} <- sorts(@blog_areas)} class="px-1 py-2 text-end">
              <.link
                id={"analytics-sort-#{key}"}
                patch={page_path(@socket, @period, key)}
                aria-sort={(key == @sort && "descending") || "none"}
                class={[
                  "inline-flex items-center gap-1",
                  (key == @sort && "text-[#4f4bcc]") || "hover:text-[#1b1a18]"
                ]}
              >
                {label}
                <.icon :if={key == @sort} name="hero-chevron-down" class="size-3" />
              </.link>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={post <- Analytics.sort_posts(@panels.posts.top, @sort)}
            class="border-t border-[#f0efea]"
          >
            <td class="max-w-[280px] px-1 py-2.5">
              <div class="truncate font-bold text-[#1b1a18]">{post.title}</div>
              <div class="mt-0.5 text-[11px] font-medium text-[#a8a5a0]">
                {published_label(post)}
              </div>
            </td>
            <td class="px-1 text-end font-semibold">{Localized.compact(post.views)}</td>
            <td class="px-1 text-end font-semibold">{Localized.compact(post.readers)}</td>
            <td :if={Home.holds?(@blog_areas, [:comment])} class="px-1 text-end font-semibold">
              {Localized.number(post.comments || 0)}
            </td>
            <td :if={Home.holds?(@blog_areas, [:comment])} class="px-1 text-end font-semibold">
              {Home.percent(post.engagement || 0)}
            </td>
            <td class={["px-1 text-end font-semibold", change_tone(post.change)]}>
              {change_label(post.change)}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </.panel>

  <div class="grid grid-cols-2 gap-4 max-[980px]:grid-cols-1!">
    <.panel
      id="analytics-rising"
      icon="hero-arrow-trending-up"
      title={gettext("Rising Posts")}
      note={gettext("Biggest growth against the previous %{days} days", days: @period.days)}
      loading={is_nil(@panels.posts)}
    >
      <.post_list
        :if={@panels.posts}
        posts={@panels.posts.rising}
        empty={gettext("No post grew in this period.")}
        figure={&change_label(&1.change)}
        tone={&change_tone(&1.change)}
      />
    </.panel>

    <.panel
      id="analytics-quiet"
      icon="hero-moon"
      title={gettext("Quiet Posts")}
      note={gettext("Published, and almost nobody read them in this period")}
      loading={is_nil(@panels.posts)}
    >
      <.post_list
        :if={@panels.posts}
        posts={@panels.posts.quiet}
        empty={quiet_empty(@panels.posts)}
        figure={&counted(:views, &1.views)}
      />
    </.panel>
  </div>
</div>
