<div>
  <.link
    navigate={path(@socket, "/admin/dashboard/blog")}
    class="mb-[18px] inline-flex items-center gap-[7px] text-[12.5px] font-semibold text-[#8a877f] transition-colors hover:text-[#1b1a18]"
  >
    <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" /> {gettext(
      "Back to Blog Dashboard"
    )}
  </.link>

  <.header>
    {gettext("Analytics")}
    <:subtitle>
      {gettext(
        "How your posts are actually being read, counted from the view log — one view is one reader opening one post."
      )}
    </:subtitle>
    <:actions>
      <div class="inline-flex items-center gap-1 rounded-[12px] border border-[#ecebe6] bg-white p-1 shadow-[0_1px_2px_rgba(30,28,24,0.04)] max-[560px]:w-full!">
        <button
          :for={days <- Analytics.ranges()}
          type="button"
          id={"analytics-range-#{days}"}
          phx-click="select_range"
          phx-value-days={days}
          aria-pressed={to_string(days == @days)}
          class={[
            "h-8 rounded-[9px] px-3.5 text-[12px] font-semibold transition-colors max-[560px]:flex-1!",
            (days == @days && "bg-[#f2f1fc] text-[#4f4bcc]") ||
              "text-[#6d6a63] hover:bg-[#f7f6f3]"
          ]}
        >
          {gettext("%{days} days", days: days)}
        </button>
      </div>
    </:actions>
  </.header>

  <%!-- KPI tiles, in the overview page's shape: two per row on a phone rather than three, where
        "Unique Readers" and its note both wrap. --%>
  <div
    data-role="analytics-kpis"
    class="mb-5 grid grid-cols-5 gap-4 max-[1180px]:grid-cols-3! max-[980px]:grid-cols-2!"
  >
    <div
      :for={{label, icon, tone, value, note, note_tone} <- kpi_cards(@stats, @days, @blog_areas)}
      class="rounded-2xl border border-[#ecebe6] bg-white px-5 py-[18px] shadow-[0_1px_2px_rgba(30,28,24,0.04)]"
    >
      <div class="flex items-center gap-3 max-[560px]:flex-col! max-[560px]:items-start! max-[560px]:gap-2!">
        <span class={["grid size-10 flex-none place-items-center rounded-[11px]", tone]}>
          <.icon name={icon} class="size-[19px]" />
        </span>
        <div class="min-w-0 flex-1">
          <div class="truncate text-[11.5px] font-semibold text-[#8a877f]">{label}</div>
          <div
            :if={@stats}
            class="mt-0.5 font-['Space_Grotesk'] text-[24px] font-semibold leading-[1.1] tracking-[-0.02em] text-[#17161a]"
          >
            {value}
          </div>
          <div :if={!@stats} class="mt-[7px] h-[19px] w-[58%] animate-pulse rounded bg-[#eeedea]">
          </div>
        </div>
      </div>
      <div :if={@stats} class={["mt-[11px] truncate text-[11px] font-semibold", note_tone]}>
        {note}
      </div>
      <div :if={!@stats} class="mt-[13px] h-2.5 w-[44%] animate-pulse rounded bg-[#f2f1ee]"></div>
    </div>
  </div>

  <div
    data-role="analytics-chart"
    class="mb-4 rounded-[18px] border border-[#ecebe6] bg-white px-[22px] py-5 shadow-[0_1px_2px_rgba(30,28,24,0.04)]"
  >
    <div class="mb-[18px] flex flex-wrap items-start justify-between gap-4">
      <div class="flex items-center gap-[11px]">
        <span class="grid size-8 place-items-center rounded-[9px] bg-[#f2f1fc] text-[#5b57d6]">
          <.icon name="hero-chart-bar" class="size-4" />
        </span>
        <div>
          <div class="font-['Space_Grotesk'] text-[16px] font-bold text-[#17161a]">
            {gettext("Views Over Time")}
          </div>
          <div class="mt-px text-[12px] font-medium text-[#8a877f]">
            {gettext("One point per day, over the last %{days} days", days: @days)}
          </div>
        </div>
      </div>

      <div :if={@stats && @stats.peak.count > 0} class="text-end">
        <div class="font-['Space_Grotesk'] text-[15px] font-bold text-[#17161a]">
          {Localized.compact(@stats.peak.count)}
        </div>
        <div class="mt-px text-[11.5px] font-medium text-[#a8a5a0]">
          {gettext("Busiest day · %{day}", day: day_label(@stats.peak.date))}
        </div>
      </div>
    </div>

    <div :if={!@stats} class="mt-[18px] animate-pulse">
      <div class="flex h-[190px] items-end gap-1.5">
        <div
          :for={h <- [38, 62, 30, 78, 52, 88, 44, 70, 34, 82, 58, 46, 74, 40]}
          class="flex-1 rounded-t bg-[#f2f1ee]"
          style={"height: #{h}%"}
        >
        </div>
      </div>
      <div class="mt-3 h-3 w-[22%] rounded bg-[#f2f1ee]"></div>
    </div>

    <div
      :if={@stats && @stats.views_window == 0}
      class="flex flex-col items-center justify-center gap-2.5 rounded-[14px] border border-dashed border-[#e6e4de] py-12 text-center"
    >
      <span class="grid size-10 place-items-center rounded-[11px] bg-[#f2f1ec] text-[#a8a5a0]">
        <.icon name="hero-eye-slash" class="size-[18px]" />
      </span>
      <div class="text-[12px] font-medium text-[#8a877f]">
        {gettext("No views recorded in the last %{days} days.", days: @days)}
      </div>
    </div>

    <%!-- The viewBox is stretched to the card, so every stroke carries `non-scaling-stroke` — without
          it the line thins out as the card widens. --%>
    <div :if={@stats && @stats.views_window > 0}>
      <svg
        viewBox={view_box()}
        preserveAspectRatio="none"
        role="img"
        aria-label={chart_label(@stats)}
        class="h-[180px] w-full"
      >
        <line
          :for={y <- gridlines()}
          x1="0"
          y1={y}
          x2={chart_width()}
          y2={y}
          stroke="#f0efea"
          stroke-width="1"
          vector-effect="non-scaling-stroke"
        />
        <path d={area_path(@stats.series, @stats.peak.count)} fill="#eef1fc" />
        <path
          d={line_path(@stats.series, @stats.peak.count)}
          fill="none"
          stroke="#5b57d6"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <div class="mt-2.5 flex items-center justify-between text-[11px] font-medium text-[#a8a5a0]">
        <span>{day_label(@stats.from)}</span>
        <span>
          {gettext("%{views} views in this period", views: Localized.compact(@stats.views_window))}
        </span>
        <span>{day_label(@stats.to)}</span>
      </div>
    </div>
  </div>

  <div data-role="analytics-bottom" class="grid grid-cols-3 gap-4 max-[980px]:grid-cols-1!">
    <div class="col-span-2 rounded-[18px] border border-[#ecebe6] bg-white px-[22px] py-5 shadow-[0_1px_2px_rgba(30,28,24,0.04)] max-[980px]:col-span-1!">
      <div class="font-['Space_Grotesk'] text-[16px] font-semibold text-[#17161a]">
        {gettext("Top Performing Posts")}
      </div>
      <div class="mt-[3px] text-[12px] font-medium text-[#8a877f]">
        {gettext("Most-read posts of the last %{days} days", days: @days)}
      </div>

      <div :if={!@stats} class="mt-[18px] flex animate-pulse flex-col gap-2.5">
        <div
          :for={_row <- 1..5}
          class="flex items-center gap-3 rounded-[12px] border border-[#f0efea] bg-[#fdfdfc] px-4 py-3"
        >
          <div class="size-7 flex-none rounded-[8px] bg-[#f2f1ee]"></div>
          <div class="min-w-0 flex-1">
            <div class="h-3 w-[54%] rounded bg-[#eeedea]"></div>
            <div class="mt-2 h-[9px] w-[28%] rounded bg-[#f2f1ee]"></div>
          </div>
          <div class="h-3 w-[42px] flex-none rounded bg-[#f2f1ee]"></div>
        </div>
      </div>

      <div :if={@stats} class="mt-[18px] flex flex-col gap-2.5">
        <div
          :for={{post, rank} <- Enum.with_index(@stats.top_posts, 1)}
          class="flex items-center gap-3 rounded-[12px] border border-[#f0efea] bg-[#fdfdfc] px-4 py-3"
        >
          <span class="grid size-7 flex-none place-items-center rounded-[9px] bg-[#f2f1fc] font-['Space_Grotesk'] text-[12px] font-bold text-[#5b57d6]">
            {rank}
          </span>

          <div class="min-w-0 flex-1">
            <div class="truncate text-[12.5px] font-bold leading-snug text-[#1b1a18]">
              {post.title}
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-2 text-[11px] font-medium text-[#a8a5a0]">
              <span class={[
                "rounded-md px-1.5 py-px text-[9px] font-bold uppercase tracking-[0.04em]",
                Home.status_tone(post.status)
              ]}>
                {Home.status_label(post.status)}
              </span>
              <span>{published_label(post)}</span>
            </div>
          </div>

          <div class="flex-none text-end">
            <div class="font-['Space_Grotesk'] text-[14px] font-bold text-[#17161a]">
              {Localized.compact(post.views)}
            </div>
            <div class="text-[10.5px] font-medium text-[#a8a5a0]">{gettext("views")}</div>
          </div>
        </div>

        <div
          :if={@stats.top_posts == []}
          class="flex flex-col items-center justify-center gap-2.5 rounded-[12px] border border-dashed border-[#e6e4de] py-9 text-center"
        >
          <span class="grid size-10 place-items-center rounded-[11px] bg-[#f2f1ec] text-[#a8a5a0]">
            <.icon name="hero-document-text" class="size-[18px]" />
          </span>
          <div class="text-[12px] font-medium text-[#8a877f]">
            {gettext("No post was opened in this period.")}
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div class="rounded-[18px] border border-[#ecebe6] bg-white px-[22px] py-5 shadow-[0_1px_2px_rgba(30,28,24,0.04)]">
        <div class="font-['Space_Grotesk'] text-[16px] font-semibold text-[#17161a]">
          {gettext("Referrers")}
        </div>
        <div class="mt-[3px] text-[12px] font-medium text-[#8a877f]">
          {gettext("The page each reader arrived from")}
        </div>

        <div :if={!@stats} class="mt-[18px] flex animate-pulse flex-col gap-3.5">
          <div :for={w <- [72, 54, 38, 26]}>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <div class="h-3 w-[38%] rounded bg-[#eeedea]"></div>
              <div class="h-3 w-[34px] rounded bg-[#f2f1ee]"></div>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-[#f4f3ef]">
              <div class="h-full rounded-full bg-[#eeedea]" style={"width: #{w}%"}></div>
            </div>
          </div>
        </div>

        <div :if={@stats} class="mt-[18px] flex flex-col gap-3.5">
          <div :for={source <- @stats.referrers}>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <span class="truncate text-[12.5px] font-medium text-[#6d6a63]">
                {referrer_label(source.label)}
              </span>
              <span class="flex-none font-['Space_Grotesk'] text-[12.5px] font-bold text-[#17161a]">
                {share(source.count, @stats.views_window)}
              </span>
            </div>
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-[#f2f1ec]">
              <div
                class="h-full rounded-full bg-[#5b57d6]"
                style={share_width(source.count, @stats.views_window)}
              />
            </div>
          </div>

          <div
            :if={@stats.referrers == []}
            class="rounded-[12px] border border-dashed border-[#e6e4de] py-7 text-center text-[12px] font-medium text-[#8a877f]"
          >
            {gettext("No views recorded in this period.")}
          </div>
        </div>
      </div>

      <div class="rounded-[18px] border border-[#ecebe6] bg-white px-[22px] py-5 shadow-[0_1px_2px_rgba(30,28,24,0.04)]">
        <div class="font-['Space_Grotesk'] text-[16px] font-semibold text-[#17161a]">
          {gettext("Audience")}
        </div>
        <div class="mt-[3px] text-[12px] font-medium text-[#8a877f]">
          {gettext("Signed in when they read, or not")}
        </div>

        <div :if={!@stats} class="mt-[18px] flex animate-pulse flex-col gap-3.5">
          <div :for={w <- [64, 36]}>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <div class="h-3 w-[32%] rounded bg-[#eeedea]"></div>
              <div class="h-3 w-[46px] rounded bg-[#f2f1ee]"></div>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-[#f4f3ef]">
              <div class="h-full rounded-full bg-[#eeedea]" style={"width: #{w}%"}></div>
            </div>
          </div>
        </div>

        <div
          :if={@stats && @stats.views_window > 0}
          class="mt-[18px] flex flex-col gap-3.5"
        >
          <div :for={
            {label, count, bar} <- [
              {gettext("Signed-in readers"), @stats.audience.members, "bg-[#5b57d6]"},
              {gettext("Guests"), @stats.audience.guests, "bg-[#c3c0b8]"}
            ]
          }>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <span class="truncate text-[12.5px] font-medium text-[#6d6a63]">{label}</span>
              <span class="flex-none font-['Space_Grotesk'] text-[12.5px] font-bold text-[#17161a]">
                {Localized.compact(count)} · {share(count, @stats.views_window)}
              </span>
            </div>
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-[#f2f1ec]">
              <div
                class={["h-full rounded-full", bar]}
                style={share_width(count, @stats.views_window)}
              />
            </div>
          </div>
        </div>

        <div
          :if={@stats && @stats.views_window == 0}
          class="mt-[18px] rounded-[12px] border border-dashed border-[#e6e4de] py-7 text-center text-[12px] font-medium text-[#8a877f]"
        >
          {gettext("No views recorded in this period.")}
        </div>
      </div>
    </div>
  </div>
</div>
