SPDX-License-Identifier: Apache-2.0
--%>

<div>
  <div>
    <div
      data-role="col-head"
      class="mb-[22px] flex flex-wrap items-start justify-between gap-6 max-[560px]:flex-col!"
    >
      <div>
        <h1 class="m-0 font-['Newsreader'] text-[30px] font-medium leading-[1.05] tracking-[-0.01em] text-[#17161a]">
          {gettext("Comments Management")}
        </h1>
        <div class="mt-[7px] text-[13.5px] font-medium text-[#7c7a75]">
          {gettext("Moderate, review, and manage blog comments.")}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 max-[560px]:w-full!">
        <.link
          id="back-to-blog-btn"
          navigate={path(@socket, "/admin/dashboard/blog")}
          class="inline-flex h-[42px] items-center gap-[7px] rounded-xl border border-[#ecebe6] bg-white px-[15px] text-[12.5px] font-semibold text-[#5c5a54] transition-colors hover:bg-[#f7f6f3] max-[560px]:flex-1! max-[560px]:justify-center!"
        >
          <.icon name="hero-chevron-left" class="size-[15px] rtl:rotate-180" /> {gettext(
            "Back to Dashboard"
          )}
        </.link>

        <button
          type="button"
          id="add-comment-btn"
          phx-click="add_comment"
          class="inline-flex h-[42px] items-center gap-2 rounded-xl bg-[linear-gradient(140deg,#6d69e6,#4f4bcc)] px-[17px] text-[12.5px] font-bold text-white shadow-[0_5px_14px_rgba(79,75,204,0.28)] transition-opacity hover:opacity-95 max-[560px]:flex-1! max-[560px]:justify-center!"
        >
          <.icon name="hero-plus" class="size-4" /> {gettext("Add Comment")}
        </button>
      </div>
    </div>

    <%!-- Comment Form Modal (MishkaGervaz) --%>
    <.modal id="comment-form-modal">
      <.live_component
        module={MishkaGervaz.Form.Web.Live}
        id={MishkaGervaz.Resource.Info.Form.component_id(MishkaBlog.Comment)}
        resource={MishkaBlog.Comment}
        current_user={@current_user}
        defaults={@reply_defaults}
      />
    </.modal>

    <%!-- Comments Table/CommentCard Component (MishkaGervaz) --%>
    <.live_component
      module={MishkaGervaz.Table.Web.Live}
      id="comments-table"
      resource={MishkaBlog.Comment}
      current_user={@current_user}
      url_state={@url_state}
    />
  </div>
</div>
